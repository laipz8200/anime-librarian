# Required: API key for the published Dify workflow
ANIMELIBRARIAN_DIFY_API_KEY=your-api-key-here

# Required unless passed with --source and --target
ANIMELIBRARIAN_SOURCE_PATH=/path/to/your/downloads
ANIMELIBRARIAN_TARGET_PATH=/path/to/your/video/collection

# Optional: Dify workflow endpoint
ANIMELIBRARIAN_DIFY_WORKFLOW_RUN_ENDPOINT=https://api.dify.ai/v1/workflows/run

# Optional: positive API timeout in seconds (default: 300)
ANIMELIBRARIAN_API_TIMEOUT=300

# Optional: Dify request user (default: Anime Librarian)
ANIMELIBRARIAN_USER_NAME=Anime Librarian
